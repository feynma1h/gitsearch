# Copy to .env and fill in the secrets. .env is gitignored.

# --- Required for crawling ---
# Personal access token; classic or fine-grained, no special scopes
# needed for public data. Rate limit is 5000 GraphQL points/hour per
# token (single-token, see ADR for multi-token rotation discussion).
# The search service also reads this (optionally): when set, /guide
# explores the live repository instead of only the stored README (ADR
# 0017). In production give search its own read-only token so either
# can be revoked independently.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database ---
# When running compose, the services use the in-network hostname
# `postgres`. When running scripts from the host (e.g. the crawler or
# indexer pipeline), use `localhost`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitsearch

# Optional overrides for compose. Defaults match docker-compose.yml.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=gitsearch
# POSTGRES_PORT=5432
# EMBEDDING_PORT=8001
# SEARCH_PORT=8002

# --- Service-to-service URLs (used by the crawler / indexer / search
#     when running from the host instead of inside compose) ---
EMBEDDING_SERVICE_URL=http://localhost:8001

# --- Optional: usage guides (ADR 0016) ---
# The search service's /guide endpoint generates a short "how do I use
# this?" summary per repo with Claude Haiku 4.5 and caches it. Leave unset
# to disable the endpoint (search still works without it).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: eval judge (search/eval/judge.py) ---
# The offline relevance judge defaults to Gemini — deliberately a
# different model family from the product pipeline. Only needed when
# (re)building eval qrels; never read by the services.
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
