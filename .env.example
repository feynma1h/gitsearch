# Copy to .env and fill in the secrets. .env is gitignored.

# --- Required for crawling ---
# Personal access token; classic or fine-grained, no special scopes
# needed for public data. Rate limit is 5000 GraphQL points/hour per
# token (single-token, see ADR for multi-token rotation discussion).
# The search service also reads this (optionally): when set, /guide
# explores the live repository instead of only the stored README (ADR
# 0017). In production give search its own read-only token so either
# can be revoked independently.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database ---
# When running compose, the services use the in-network hostname
# `postgres`. When running scripts from the host (e.g. the crawler or
# indexer pipeline), use `localhost`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gitsearch

# Optional overrides for compose. Defaults match docker-compose.yml.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=gitsearch
# POSTGRES_PORT=5432
# EMBEDDING_PORT=8001
# SEARCH_PORT=8002

# --- Service-to-service URLs (used by the crawler / indexer / search
#     when running from the host instead of inside compose) ---
EMBEDDING_SERVICE_URL=http://localhost:8001

# --- Optional: usage guides (ADR 0016) + eval spot-judge (ADR 0020) ---
# The search service's /guide endpoint generates a short "how do I use
# this?" summary per repo with Claude Haiku 4.5 and caches it. Leave unset
# to disable the endpoint (search still works without it). Also read by
# search/eval/spot_judge.py, the second-family re-grade of the Gemini
# qrels.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: Gemini (LLM enrichment, ADR 0020 + eval judge) ---
# Read by indexer/pipeline/enrich_llm.py, the batch enrichment pass, and
# by search/eval/judge.py when (re)building eval qrels — the offline
# judge is deliberately a different model family from the product
# pipeline. Not read by the search or embedding services. The judge (not
# the enrichment pass) also accepts GOOGLE_API_KEY as an alias, and
# OPENAI_API_KEY for its --provider openai path.
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: search service retrieval switches (ADR 0020) ---
# Both default to the values below; set them only to flip behaviour.
# PHASE2_RETRIEVAL=off serves the exact pre-enrichment (ADR 0018)
# statement — the rollback lever if the enrichment/signals tables are
# ever dropped. EMBEDDINGS_MODEL_LABEL picks which stored embedding
# generation the dense lane serves (rows are keyed by label; enriched
# documents live under "BAAI/bge-small-en-v1.5+enrich-v1").
# PHASE2_RETRIEVAL=on
# EMBEDDINGS_MODEL_LABEL=BAAI/bge-small-en-v1.5

# --- Optional: search service tuning (defaults shown) ---
# ALLOWED_ORIGINS narrows CORS to the deployed frontend origin (comma-
# separated); "*" is for local dev only. SEARCH_RATE_LIMIT is a slowapi
# limit string — raise it locally so the eval harness can sweep at full
# speed, leave it unset in production. SEARCH_RRF_K is the fusion
# constant (ADR 0018, retuned in 0020).
# ALLOWED_ORIGINS=*
# SEARCH_RATE_LIMIT=30/minute
# SEARCH_RRF_K=20

# --- Optional: batch job / embedding service tuning (defaults shown) ---
# DB_POOL_MAX_SIZE sizes the crawler's asyncpg pool.
# EMBED_TIMEOUT_SECONDS is the indexer's per-request timeout against the
# embedding service (a full batch can run minutes on a throttled
# machine). EMBEDDING_MODEL and MAX_BATCH_SIZE configure the embedding
# service itself and only apply when running it from the host — compose
# sets them inline in docker-compose.yml.
# DB_POOL_MAX_SIZE=10
# EMBED_TIMEOUT_SECONDS=300
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MAX_BATCH_SIZE=128
